class Solution {
	public:
	long long int fun(long long int n)
	{
		if (n == 1)
			return 2;
		
		long long int k = 1e9 + 7;
		if (n%2 == 0)
			{
			long long int a = fun(n/2);
			return (a%k*a%k)%k;
		}
		else
			{
			long long int a = fun(n/2);
			long long int p = (a%k*a%k)%k;
			return (2%k*p%k)%k;
		}
	}
	int subsequenceSum(string &s) {
		// code here
		long long int n = s.size();
		if(n==1)
		return s[0]-'0';
		
		n--;
		long long int val = fun(n);
		long long int k = 1e9 + 7;
		long long int ans=0;
		for(int i=0;i<s.size();i++)
		{
		   
	 long long int cu=(s[i]-'0');
	      ans=(ans%k+(cu%k*val%k)%k)%k;
		}
		return ans;
		
	}
};
