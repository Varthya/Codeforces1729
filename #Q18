#include<iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main()
{

    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int f=1;
        int s=n;

        int x=1;
        vector<int>temp;
        while(n--)
        {
            if(x==1)
            {
                temp.push_back(s);
                s--;
            }
            else
            {
                temp.push_back(f);
                f++;
            }
            x=x^1;
        }
        reverse(temp.begin(),temp.end());
        
        for(int i=0; i<temp.size(); i++)
            cout<<temp[i]<<" ";
        cout<<endl;
    }

}