#include<iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main()
{

    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>v(n,0);
        for(int i=0; i<n; i++)
        {
            int x;
            cin>>x;
            v[i]=x;
        }
        vector<int>ans(n-1,0);
        int ma=INT_MAX;
        for(int i=0;i<n-1;i++)
        {
        ans[i]=max(v[i],v[i+1]);
        ma=min(ma,ans[i]);
        }
        cout<<(ma-1)<<endl;
        
    }

}