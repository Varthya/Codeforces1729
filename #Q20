#include<iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main()
{

    int t;
    cin>>t;
    while(t--)
    {
        vector<int>v(7,0);
        for(int i=0; i<7; i++)
        {
            int x;
            cin>>x;
            v[i]=x;
        }
        sort(v.begin(),v.end());
        int sum1=v.back();
        int sum2=0;
        for(int i=0;i<6;i++)
        {
          sum2+=v[i];
        }
        sum2*=-1;
        cout<<(sum2+sum1)<<endl;
        
    }

}