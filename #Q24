#include<iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main()
{

    int t;
    cin>>t;
    while(t--)
    {
        long long  int n;
        cin>>n;
        long long int ans=1;
        for(long long int i=2; i*i<=n; i++)
        {
            long long int p=1;
            while(n%i==0)
            {
                p=i;
                n=n/i;
            }
            ans*=p;
        }
        if(n!=1)
            ans*=n;

        cout<<ans<<endl;
    }

}
