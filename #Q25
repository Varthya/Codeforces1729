class Solution {
  public:
    long long countPairs(vector<int>& arr) {
        // code here
        int n=arr.size();
        long long ans=0;
        unordered_map<int,int>mp;
        for(int i=0;i<n;i++)
        {
            arr[i]=arr[i]-i;
            ans=ans+mp[arr[i]];
            mp[arr[i]]++;
        }
        return 2*ans;
    }
};
