#include<iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main()
{

    int t;
    cin>>t;
    while(t--)
    {
        long long int n;
        cin>>n;
        n++;
        int flag=true;
        for(long long int i=2; i*i<=(n); i++)
        {
            if(n%i==0)
            {
                flag=false;
            }
        }
        if(flag==true)
        {
            cout<<"YES"<<endl;
        }
        else
        {
            cout<<"NO"<<endl;
        }
    }

}