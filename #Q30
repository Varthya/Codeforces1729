#include<bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>v(n,0);
        for(int i=0;i<n;i++)
        {
          int x;
          cin>>x;
          v[i]=x;
        }
        sort(v.begin(),v.end(),greater<int>());
        int flag=true;
        for(int i=0;i<n-2;i++)
        {
        if((v[i]%v[i+1])!=v[i+2])
               flag=false;
        }
        if(flag==true)
          cout<<v[0]<<" "<<v[1]<<endl;
        else
          cout<<-1<<endl;
    }
}