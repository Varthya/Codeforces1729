#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>arr(n,0);
        int ma=0;
        int mi=-1;
        for(int i=0; i<n; i++)
        {
            int x;
            cin>>x;
            arr[i]=x;
            if(x>ma)
            {
                ma=x;
                mi=i;
            }
        }
        int flag=true;
        for(int i=0;i<mi;i++)
        {
        if(arr[i]>arr[i+1])
           flag=false;
        }
        for(int i=mi;i<n-1;i++)
        {
           if(arr[i]<arr[i+1])
              flag=false;
        }
        if(flag)
        cout<<"YES"<<endl;
        else
        cout<<"NO"<<endl;

    }
}