class Solution {
  public:
     bool check(int i,int j,int n,int m)
     {
         return (i>=0&&i<n&&j>=0&&j<m);
     }
    int findPerimeter(vector<vector<int>> &mat) {
        // code here
           int count=0;
           int n=mat.size();
           int m=mat[0].size();
        for(int i=0;i<mat.size();i++)
        {
            for(int j=0;j<mat[0].size();j++)
            {
                int top=i-1;
                int bot=i+1;
                int left=j-1;
                int right=j+1;
                if(mat[i][j]==1)
               {
                   if(top<0)
                    count++;
                   if(bot==n)
                    count++;
                   if(left<0)
                    count++;
                   if(right==m)
                    count++;
                   if(check(i-1,j,n,m))
                   {
                       if(mat[i-1][j]==0)
                         count++;
                   }
                  if(check(i+1,j,n,m))
                   {
                       if(mat[i+1][j]==0)
                         count++;
                   }
                   if(check(i,j-1,n,m))
                   {
                       if(mat[i][j-1]==0)
                           count++;
                   }
                   if(check(i,j+1,n,m))
                   {
                       if(mat[i][j+1]==0)
                         count++;
                   }
                        
               }
            }
        }
        return count;
    }
};