class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        int n = nums.size();
        for (int i = 0; i < n; i++) {
            nums[i] = (nums[i] * nums[i]);
        }
        sort(nums.begin(), nums.end());
        long long sum = 0;
        int low = 0;
        int high = n - 1;
        while (low < high) {
            sum += (nums[high] - nums[low]);
            high--;
            low++;
        }
        if (low == high)
            sum += nums[low];
        return sum;
    }
};