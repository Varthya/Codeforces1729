class Solution {
  public:
    string findRollOut(string& s, vector<int>& roll) {
        // code here
        int n=s.size();
        vector<int>dp(n,0);
        for(int i=0;i<roll.size();i++)
        {
            dp[roll[i]-1]++;
        }
        for(int i=n-2;i>=0;i--)
        {
            dp[i]+=dp[i+1];
        }
        string ans="";
        for(int i=0;i<s.size();i++)
        {
            int k=s[i]-'a';
            int p=(k+dp[i])%26;
            int z='a';
            char d=z+p;
            ans.push_back(d);
        }
        return ans;
    }
};
