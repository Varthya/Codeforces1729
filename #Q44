class Solution {
public:
    int minMoves(vector<int>& nums) {
        int ma = -1;
        for (int i = 0; i < nums.size(); i++) {
            if (ma < nums[i])
                ma = nums[i];
        }
        int ans = 0;
        for (int i = 0; i < nums.size(); i++) {
            ans += (ma - nums[i]);
        }
        return ans;
    }
};