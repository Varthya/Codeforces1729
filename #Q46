class Solution {
public:
    bool checkString(string s) {
        int count_a=0;
        int count_b=0;
        for(int i=0;i<s.size();i++)
        {  
            if(s[i]=='b')
              count_b++;

            if(count_b&&(s[i]=='a'))
            {
                return false;
            }
        }
        return true;
    }
};