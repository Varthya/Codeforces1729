#include<iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main()
{

    int t;
    cin>>t;
    while(t--)
    {
        long long int n,k;
        cin>>n>>k;
        if(n%2!=0)
        {
          n-=k;
          k--;
          int ans=n/k+1;
          if(n%k!=0)
             ans++;
             
          cout<<ans<<endl;
        }
        else
        {
           k--;
          int ans=n/k;
          if(n%k!=0)
             ans++;
             
          cout<<ans<<endl;
        }

    }
}